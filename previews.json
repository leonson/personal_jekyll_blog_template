---
layout: null
---
{
  "posts": [
    {% for post in site.posts %}
    {
      "url": "{{ post.url }}",
      "title": {{ post.title | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | truncatewords: 50 | jsonify }},
      "date": "{{ post.date | date_to_xmlschema }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}